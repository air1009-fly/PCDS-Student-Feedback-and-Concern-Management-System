{
  "rewrites": [
    { "source": "/login", "destination": "/api/login" },
    { "source": "/register", "destination": "/api/register" },
    { "source": "/users", "destination": "/api/users" },
    { "source": "/users/:path*", "destination": "/api/users/:path*" },
    { "source": "/concerns", "destination": "/api/concerns" },
    { "source": "/concerns/:path*", "destination": "/api/concerns/:path*" }
  ]
}
